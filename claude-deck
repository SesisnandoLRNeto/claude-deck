def fmt_tokens(n):
    if n >= 1_000_000: return f"{n/1_000_000:.1f}M"
    if n >= 1_000:     return f"{n/1_000:,.0f}"
    return str(n)

def fmt_cost(c):
    return f"${c:.2f}" if c >= 1 else f"${c:.4f}"

def short_model(m):
    return SHORT_MODEL.get(m, m)

def calc_cost(inp, out, cr, cw, model):
    p = PRICING.get(model, PRICING["claude-opus-4-6"])
    return (inp/1e6)*p["input"] + (out/1e6)*p["output"] + (cr/1e6)*p["cache_read"] + (cw/1e6)*p["cache_write"]

def shorten_path(path):
    home = str(Path.home())
    return ("~" + path[len(home):]) if path.startswith(home) else path

def build_spark(values, width=20):
    if not values: return ""
    blocks = " ▁▂▃▄▅▆▇█"
    recent = values[-width:]
    mx = max(max(recent), 0.1)
    return "".join(blocks[min(int((v/mx)*8), 8)] for v in recent)

