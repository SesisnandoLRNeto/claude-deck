def discover_config_dirs():
    """Return [{name, color, path}] for each Claude account on disk."""
    seen, dirs = set(), []

    def add(path, name, color):
        p = Path(path).expanduser()
        if p.is_dir() and p not in seen:
            seen.add(p)
            dirs.append({"name": name, "color": color, "path": p})

    add(Path.home() / ".claude",      "personal", "#89b4fa")  # blue
    add(Path.home() / ".claude-work", "work",     "#f38ba8")  # pink/red
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        add(env, "env", "#a6e3a1")  # green
    return dirs


