        yield Static("", id="command-bar")

    def on_mount(self) -> None:
        self._render_command_bar()
        self.refresh_data()
        self.set_interval(3, self.refresh_data)
        self.set_interval(0.4, self._poll_hosted)

    def on_unmount(self) -> None:
        if self.hosted:
            self.hosted.close()
        if self.term:
            self.term.shutdown()

    def _poll_hosted(self) -> None:
        if self.hosted and self.hosted.drain() and self.focus_sid == "__hosted__":
            self._render_focus()

    def action_cycle_log(self) -> None:
        self.log_lines = 20 if self.log_lines == 10 else 10
        self._render_selected()

    def _render_command_bar(self):
        self.query_one("#command-bar", Static).update(
            "[b]click[/]:Panels  [b]2×click[/]:Chat  [b]n[/]:New  [b]m[/]:Mirror/Transcript  "
            "[b]esc[/]:Back  [b]j[/]:Jump  [b]p[/]:Pin  "
            "[b]R[/]:Resume-all  [b]q[/]:Quit  │  ↻ 3s"
        )

    def refresh_data(self) -> None:
        self.all_processes = get_claude_processes()
        pid_index = build_pid_index()
        tag_processes(self.all_processes, pid_index)

        session_pairs = get_active_sessions(len(self.all_processes))
        seen_sids = {os.path.basename(fp).replace(".jsonl", "") for fp, _ in session_pairs}

        # Always include every live session, even if its file is older than the
        # age window — those are the tabs the user most wants to jump to.
        for p in self.all_processes:
            sid = p.get("session_id")
            acct = p.get("account")
            if sid and acct and sid not in seen_sids:
                fp = find_session_file(acct, sid)
                if fp:
                    session_pairs.append((fp, acct))
                    seen_sids.add(sid)

        # Always include pinned sessions too, so they show on startup even if old.
        for sid in self.pins:
            if sid not in seen_sids:
                hit = find_session_file_any(sid)
                if hit:
                    session_pairs.append(hit)
                    seen_sids.add(sid)

        self.all_sessions = [parse_session(fp, acct) for fp, acct in session_pairs]

        # Real join on sessionId — liveness comes from a running process, never
        # from the stale sessions/<pid>.json files.
        proc_by_sid = {p["session_id"]: p
                       for p in self.all_processes if p.get("session_id")}
        for s in self.all_sessions:
            s["_proc"] = proc_by_sid.get(s["session_id"])
            s["_live"] = s["_proc"] is not None

        if self.selected_idx >= len(self.all_sessions):
            self.selected_idx = 0

        # sid -> (filepath, account) so the focus view can open any listed session.
        self.sid_files = {fp_sid(fp): (fp, acct) for fp, acct in session_pairs}

        # sid -> clean session name (e.g. 'fusion-753'), from the sessions/*.json.
        self.name_by_sid = {info["sessionId"]: info["name"]
                            for info in pid_index.values()
                            if info.get("sessionId") and info.get("name")}

        self._render_list()
        self._render_selected()
        if self.focus_sid:
            self._render_focus()

    def _render_list(self):
        """Render either the recent rows or the resume (all) rows into the list,
        with pinned conversations grouped into their own section at the top."""
        if self.resume_mode:
            live_by_sid = {p["session_id"]: p
                           for p in self.all_processes if p.get("session_id")}
            rows = build_resume_rows(self.resume_metas, live_by_sid, self.pins,
                                     self.name_by_sid)
            for m in self.resume_metas:
                self.sid_files.setdefault(m["session_id"], (m["filepath"], m["account"]))
        else:
            rows = build_recent_rows(self.all_sessions, self.pins, self.name_by_sid)

        pinned = [r for r in rows if r.get("pinned")]
        others = [r for r in rows if not r.get("pinned")]

        display = []
        n = 0

        def add_chat(r):
            nonlocal n
            n += 1
            display.append({"key": r["key"], "live": r["live"], "tty": r["tty"],
                            "header": False, "markup": recent_row_markup(r, n)})

        def add_header(key, text):
            display.append({"key": key, "live": False, "tty": "",
                            "header": True, "markup": text})

        # Pinned chats first (each marked with ★), then a divider, then the rest.
        # No header above the first row, so the cursor always lands on a real chat.
        for r in pinned:
            add_chat(r)
        if pinned and others:
            add_header("__hdr_div__", "[dim]──────  pinned ↑  ·  others ↓  ──────[/]")
        for r in others:
            add_chat(r)

        self._render_recent_tasks(display)

    # ── Recent Tasks ─────────────────────────────────────────────────────

    def _render_recent_tasks(self, rows):
        """Diff, don't rebuild — a full clear() every 3s would wipe the cursor
        and focus. Fast path updates labels in place when the row set is same."""
        lv = self.query_one("#recent-tasks", ListView)
        existing_keys = [c.row_key for c in lv.children if isinstance(c, TaskRow)]
        desired_keys = [r["key"] for r in rows]

        if existing_keys == desired_keys:
            for c, r in zip(lv.children, rows):
                c.query_one(Label).update(Text.from_markup(r["markup"]))
                c.live, c.tty = r["live"], r["tty"]
            return

        saved = lv.index
        lv.clear()
        for r in rows:
            lv.append(TaskRow(tty=r["tty"], live=r["live"], markup=r["markup"],
                              row_key=r["key"], is_header=r.get("header", False)))
        if saved is not None and saved < len(rows):
            lv.index = saved

    def _jump_row(self, item) -> None:
        if not isinstance(item, TaskRow):
            return
        if item.live and item.tty:
            if not jump_to_tty(item.tty):
                self.notify("Session not found in iTerm2 (ended or other terminal)",
                            severity="warning", timeout=3)
        else:
            self.notify("Session ended — nothing to jump to",
                        severity="information", timeout=2)

    def on_click(self, event) -> None:
        # Record mouse-click time so the row handler can tell a click from a
        # keyboard Enter (both raise ListView.Selected, but only a click fires
        # this first).
        self._mouse_click_at = time.time()

    def on_list_view_selected(self, event) -> None:
        # Keyboard Enter -> open the chat directly.
        # Mouse: single click -> dashboard panels, double click -> chat.
        if not isinstance(event.item, TaskRow) or event.item.is_header:
            return
        sid = event.item.row_key
        now = time.time()
        from_mouse = (now - self._mouse_click_at) < 0.3
        if not from_mouse:
            self._enter_focus(sid)          # keyboard Enter opens the chat
            return
        double = (sid == self._last_click_sid and now - self._last_click_time < 0.45)
        self._last_click_sid = sid
        self._last_click_time = now
        if double:
            self._enter_focus(sid)
        else:
            if self.focus_sid:
                self._exit_focus()
            self._show_session_panels(sid, allow_focus=True)

    def on_list_view_highlighted(self, event) -> None:
        # Arrow-key navigation updates the dashboard panels (but never opens chat).
        if self.focus_sid:
            return
        if isinstance(event.item, TaskRow) and not event.item.is_header:
            self._show_session_panels(event.item.row_key, allow_focus=False)

    def _show_session_panels(self, sid, allow_focus=False) -> None:
        """Point the Agent Tree / Tasks / Stats panels at this session."""
        idx = next((i for i, s in enumerate(self.all_sessions)
                    if s["session_id"] == sid), None)
        if idx is None:
            # Historical (resume) row with no live dashboard data. A click opens
            # its transcript; an arrow-highlight does nothing.
            if allow_focus:
                self._enter_focus(sid)
            return
        self.selected_idx = idx
        self._render_selected()

    def action_jump_current(self) -> None:
        # `j` jumps to the real iTerm2 tab instead of opening the embedded view.
        item = self._highlighted_row()
        if item:
            self._jump_row(item)

    def _highlighted_row(self):
        lv = self.query_one("#recent-tasks", ListView)
        if lv.index is not None and 0 <= lv.index < len(lv.children):
            item = lv.children[lv.index]
            if isinstance(item, TaskRow) and not item.is_header:
                return item
        return None

    # ── Focus (embedded conversation) ────────────────────────────────────

    _DASHBOARD_PANELS = ("#agent-tree-panel", "#tasks-panel", "#stats-panel")

    def _enter_focus(self, sid) -> None:
        if not sid:
            return
        self.focus_sid = sid
        self.pending_images = []
        self._update_input_hint()
        # Open on the colorful transcript by default; the live mirror is one
        # keypress away (m). Sending input flips to mirror to show the result.
        self.focus_view = "transcript"
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = False
        self.query_one("#focus-panel").display = True
        self._render_focus()
        # Focus the input so typing, paste, and dropped files land in the chat.
        self.query_one("#focus-input", ChatInput).focus()

    def _exit_focus(self) -> None:
        self.focus_sid = None
        self.pending_images = []
        self._update_input_hint()
        self.query_one("#focus-panel").display = False
        self.query_one("#recent-tasks", ListView).focus()
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = True

    def action_back(self) -> None:
        if self.focus_sid:
            self._exit_focus()

    def action_toggle_view(self) -> None:
        if not self.focus_sid:
            return
        self.focus_view = "transcript" if self.focus_view == "mirror" else "mirror"
        self._render_focus()

    def on_button_pressed(self, event) -> None:
        if event.button.id == "focus-back":
            self._exit_focus()
        elif event.button.id == "focus-toggle":
            self.action_toggle_view()
        elif event.button.id == "focus-attach":
            self.action_attach_image()
        elif event.button.id == "term-back":
            self._close_terminal()

    def _live_focus_tty(self):
        """tty of the focused session if it is live, else None (with a toast)."""
        if not self.focus_sid:
            self.notify("Open a conversation first", severity="warning", timeout=2)
            return None
        s = next((x for x in self.all_sessions
                  if x["session_id"] == self.focus_sid), None)
        proc = (s or {}).get("_proc") or {}
        if s and s.get("_live") and proc.get("tty"):
            return proc["tty"]
        self.notify("This session is not live — cannot send", severity="warning", timeout=3)
        return None

    def _update_input_hint(self) -> None:
        """Reflect queued images in the input's placeholder."""
        try:
            inp = self.query_one("#focus-input", ChatInput)
        except Exception:
            return
        n = len(self.pending_images)
        if n:
            inp.placeholder = (f"{n} image{'s' if n != 1 else ''} attached — "
                               f"add a message (optional) and press Enter to send")
        else:
            inp.placeholder = ("Type a message and press Enter — "
                               "paste/drag images or press i to attach")

    def action_attach_image(self) -> None:
        """`i` — queue the clipboard image to send with the next message."""
        if not self.focus_sid:
            self.notify("Open a conversation first", severity="warning", timeout=2)
            return
        img = clipboard_image_to_file()
        if not img:
            self.notify("No image in the clipboard (copy a screenshot first)",
                        severity="warning", timeout=3)
            return
        self.pending_images.append(img)
        self._update_input_hint()
        self.notify(f"Image attached ({len(self.pending_images)} queued) — Enter to send",
                    timeout=2)

    def on_paste(self, event) -> None:
        """Pasting (or dropping) into the chat.
        - Files dropped while the input is focused land in the input as text and
          are turned into attachments on send.
        - Files dropped while the input is NOT focused are queued here.
        - An empty paste (no text) means a screenshot is in the clipboard."""
        if not self.focus_sid:
            return
        text = getattr(event, "text", "") or ""
        inp = self.query_one("#focus-input", ChatInput)
        input_focused = self.focused is inp
        if text.strip():
            imgs, _rest = extract_image_paths(text)
            if imgs and not input_focused:
                self.pending_images.extend(imgs)
                self._update_input_hint()
                self.notify(f"{len(imgs)} image(s) attached", timeout=1)
                try:
                    event.stop()
                except Exception:
                    pass
            return
        # Empty paste in a chat usually means a screenshot in the clipboard.
        img = clipboard_image_to_file()
        if img:
            self.pending_images.append(img)
            self._update_input_hint()
            self.notify("Image attached (paste) — Enter to send", timeout=2)
            try:
                event.stop()
            except Exception:
                pass

    def action_new_chat(self) -> None:
        """`n` — start a new Claude session the deck runs itself. With pyte
        available it embeds the REAL interactive claude (full TUI: mode switch,
        slash commands, per-step yes/no). Otherwise it falls back to a headless
        chat. Account + folder come from the highlighted (or open) conversation."""
        # Re-attach to an already-running session if there is one.
        if HAVE_PYTE and self.term and self.term.alive:
            self._show_terminal()
            return
        if self.hosted and self.hosted.alive:
            self._open_hosted()
            self.notify("Reopened the hosted chat", timeout=1)
            return

        sid = self.focus_sid if self.focus_sid not in ("__hosted__",) else None
        if not sid:
            item = self._highlighted_row()
            sid = item.row_key if item else None
        s = next((x for x in self.all_sessions if x["session_id"] == sid), None) if sid else None
        acct = (s or {}).get("account")
        cwd = ((s or {}).get("_proc") or {}).get("cwd")
        if acct is None and CONFIG_DIRS:
            acct = CONFIG_DIRS[0]                      # default: first (personal)
        name = acct["name"] if acct else "personal"

        if HAVE_PYTE:
            self._open_terminal(acct, cwd)
            where = f" in {os.path.basename(cwd.rstrip('/'))}" if cwd and os.path.isdir(cwd) else ""
            self.notify(f"New {name} chat — interactive (Ctrl+B to detach){where}", timeout=3)
            return

        self.hosted = HostedSession(acct, cwd)
        if not self.hosted.start():
            self.notify("Could not start Claude — is the `claude` CLI on your PATH?",
                        severity="warning", timeout=4)
            self.hosted = None
            return
        self._open_hosted()
        where = f" in {os.path.basename(cwd.rstrip('/'))}" if cwd and os.path.isdir(cwd) else ""
        self.notify(f"New {name} chat (hosted by the deck){where}", timeout=3)

    # ── Embedded interactive terminal (real claude TUI) ──────────────────

    def _open_terminal(self, acct, cwd) -> None:
        env = dict(os.environ)
        path = acct.get("path") if acct else None
        if path and Path(path) != (Path.home() / ".claude"):
            env["CLAUDE_CONFIG_DIR"] = str(path)
        # Tear down any focus/hosted view, hide the dashboard panels.
        if self.focus_sid:
            self.focus_sid = None
            self.query_one("#focus-panel").display = False
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = False
        host = self.query_one("#term-host", Vertical)
        if self.term:
            self.term.shutdown()
            self.term.remove()
        self.term = TerminalPane([HOSTED_CLAUDE_BIN], env=env, cwd=cwd)
        host.mount(self.term)
        name = acct["name"] if acct else "personal"
        color = acct["color"] if acct else "#cdd6f4"
        self.query_one("#term-title", Static).update(
            f"[bold {color}]{name}[/]  interactive claude   [dim](Ctrl+B to detach)[/]")
        self.query_one("#terminal-panel").display = True

    def _show_terminal(self) -> None:
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = False
        self.query_one("#focus-panel").display = False
        self.query_one("#terminal-panel").display = True
        if self.term:
            self.term.focus()

    def _close_terminal(self) -> None:
        # Detach: hide the panel but keep the program running in the background.
        self.query_one("#terminal-panel").display = False
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = True
        self.query_one("#recent-tasks", ListView).focus()

    def on_terminal_pane_detached(self, event) -> None:
        self._close_terminal()

    def _open_hosted(self) -> None:
        self.focus_sid = "__hosted__"
        self.pending_images = []
        for pid in self._DASHBOARD_PANELS:
            self.query_one(pid).display = False
        self.query_one("#focus-panel").display = True
        self._render_focus()
        self.query_one("#focus-input", ChatInput).focus()

    # ── Pins & Resume list ───────────────────────────────────────────────

    def action_toggle_pin(self) -> None:
        item = self._highlighted_row()
        if not item:
            return
        sid = item.row_key
        if sid in self.pins:
            self.pins.discard(sid)
            self.notify("Unpinned", timeout=1)
        else:
            self.pins.add(sid)
            self.notify("Pinned", timeout=1)
        save_pins(self.pins)
        self._render_list()

    def action_toggle_resume(self) -> None:
        self.resume_mode = not self.resume_mode
        panel = self.query_one("#recent-panel")
        if self.resume_mode:
            self.resume_metas = list_all_sessions()
            panel.border_title = f"Conversations · all ({len(self.resume_metas)})"
        else:
            self.resume_metas = []
            panel.border_title = "Conversations"
        self._render_list()

    # ── Send input to a live session ─────────────────────────────────────

    def on_chat_input_submitted(self, event) -> None:
        # Paths dropped into the box become image attachments; the rest is text.
        dropped, text = extract_image_paths(event.text)
        images = list(dict.fromkeys(self.pending_images + dropped))   # de-duped
        text = text.strip()
        if not text and not images:
            return
        inp = self.query_one("#focus-input", ChatInput)

        # Deck-hosted chat.
        if self.focus_sid == "__hosted__":
            # /rename is a UI-only command Claude can't run headless, so the deck
            # handles it: name the chat here instead of sending it to the model.
            if text.lower().startswith("/rename"):
                newname = text[len("/rename"):].strip()
                if newname and self.hosted:
                    self.hosted.display_name = newname[:40]
                    inp.text = ""
                    self.notify(f"Chat renamed to “{newname[:40]}”", timeout=2)
                    self._render_focus()
                else:
                    self.notify("Usage: /rename <name>", severity="warning", timeout=2)
                return
            msg = " ".join([text] + images).strip()
            if self.hosted and self.hosted.send(msg):
                inp.text = ""
                self.pending_images = []
                self._update_input_hint()
                self._render_focus()
            else:
                self.notify("Hosted chat is not running", severity="warning", timeout=3)
            return

        tty = self._live_focus_tty()
        if not tty:
            return
        # Claude Code reads local image paths referenced in the message.
        msg = " ".join([text] + images).strip()
        if send_text_to_tty(tty, msg):
            inp.text = ""
            self.pending_images = []
            self._update_input_hint()
            self.focus_view = "mirror"      # show the result land in the terminal
            self.set_timer(0.5, self._render_focus)
        else:
            self.notify("Could not send to the iTerm2 session",
                        severity="warning", timeout=3)

    def _md(self, text):
        """Light markdown -> rich markup, with escaping done first so brackets in
        the text never break rendering. Handles **bold**, `code`, # headers, bullets."""
        t = rich_escape(text)
        t = re.sub(r"\*\*(.+?)\*\*", r"[b]\1[/b]", t)
        t = re.sub(r"`([^`]+)`", r"[#a6e3a1]\1[/]", t)
        lines = []
        for ln in t.split("\n"):
            s = ln.lstrip()
            if s.startswith("### "):
                ln = f"[bold #74c7ec]{s[4:]}[/]"
            elif s.startswith("## "):
                ln = f"[bold #89b4fa]{s[3:]}[/]"
            elif s.startswith("# "):
                ln = f"[bold #cba6f7]{s[2:]}[/]"
            elif s[:2] in ("- ", "* "):
                indent = ln[:len(ln) - len(s)]
                ln = f"{indent}[#f9e2af]•[/] {s[2:]}"
            lines.append(ln)
        return "\n".join(lines)

    def _format_transcript(self, entries):
        out = []
        for role, text in entries:
            if role == "tool":
                name = text.split()[0] if text else "tool"
                detail = text[len(name):].strip()
                tc = TOOL_COLOR.get(name, "#cba6f7")
                out.append(f"  [{tc}]⚙ {rich_escape(name)}[/] "
                           f"[dim]{rich_escape(' '.join(detail.split())[:80])}[/]")
            elif role == "user":
                out.append("")
                out.append("[#1e1e2e on #89dceb] ❯ you [/]")
                out.append(self._md(text[:1500]))
            elif role == "error":
                out.append("")
                out.append(f"[red]✗ {rich_escape(text[:1500])}[/]")
            else:
                out.append("")
                out.append("[#1e1e2e on #a6e3a1] ✦ assistant [/]")
                out.append(self._md(text[:1500]))
        return "\n".join(out) if out else "[dim]No transcript yet.[/]"

    def _scroll_chat_to_end(self) -> None:
        try:
            self.query_one("#focus-scroll", VerticalScroll).scroll_end(animate=False)
        except Exception:
            pass

    def _update_chat(self, renderable, sig) -> None:
        """Update the chat body and follow the latest content (auto-scroll to the
        bottom) whenever it grows, so you always see the newest interaction."""
        self.query_one("#focus-content", Static).update(renderable)
        if sig != self._focus_sig:
            self._focus_sig = sig
            self.call_after_refresh(self._scroll_chat_to_end)

    def _render_focus(self) -> None:
        if not self.focus_sid:
            return
        content = self.query_one("#focus-content", Static)
        title = self.query_one("#focus-title", Static)
        toggle = self.query_one("#focus-toggle", Button)
        toggle.label = "View: Transcript" if self.focus_view == "mirror" else "View: Mirror"

        # Deck-hosted chat: render from the live event stream, not a session file.
        if self.focus_sid == "__hosted__":
            h = self.hosted
            acct = (h.account if h else None) or {}
            status = h.status if h else "gone"
            chat_name = h.display_name if h else "new chat"
            title.update(
                f"[bold {acct.get('color', '#cdd6f4')}]{acct.get('name', '?')}[/]  "
                f"[b]{rich_escape(chat_name)}[/]  [dim]hosted · {status}[/]   [dim](esc: back)[/]"
            )
            if h and h.entries:
                last_len = len(h.entries[-1][1])
                self._update_chat(Text.from_markup(self._format_transcript(h.entries)),
                                  ("hosted", len(h.entries), last_len))
            else:
                content.update("[dim]Starting Claude… type your first message below "
                               "and press Enter.[/]")
            return

        sid = self.focus_sid
        s = next((x for x in self.all_sessions if x["session_id"] == sid), None)
        name = self.name_by_sid.get(sid, "")
        if s is not None:
            acct = s.get("account") or {}
            proc = s.get("_proc") or {}
            live = bool(s.get("_live"))
            filepath = s["filepath"]
            summary = s["summary"] or s["first_prompt"] or sid
        else:
            # Historical session chosen from the resume list — resolve its file.
            ref = self.sid_files.get(sid)
            if not ref:
                title.update("[dim]session not found[/]")
                content.update("[dim]Could not locate this conversation's file.[/]")
                return
            filepath, acct = ref
            proc, live = {}, False
            summary = scan_session_meta(filepath, acct)["title"]

        # Lead with the clean session name, then the summary.
        name_part = f"[b]{rich_escape(name)}[/]  " if name else ""
        label = name_part + rich_escape(" ".join(str(summary).split())[:48])
        live_tag = "[green]● live[/]" if live else "[#585b70]○ ended[/]"
        pin_tag = " [yellow]★ pinned[/]" if sid in self.pins else ""
        title.update(
            f"[bold {acct.get('color', '#cdd6f4')}]{acct.get('name', '?')}[/]  "
            f"{label}  {live_tag}{pin_tag}   [dim](m: toggle · esc: back)[/]"
        )

        if self.focus_view == "mirror":
            if live and proc.get("tty"):
                screen = get_session_screen(proc["tty"])
                if screen is None:
                    content.update("[yellow]Could not read the screen from iTerm2.[/]\n"
                                   "Press [b]m[/] for the transcript instead.")
                else:
                    self._update_chat(Text(screen.rstrip("\n")),
                                      ("mirror", sid, len(screen)))
            else:
                content.update("[dim]Not live — no terminal to mirror.[/]\n"
                               "Press [b]m[/] for the transcript.")
        else:
            entries = build_transcript(filepath)
            self._update_chat(Text.from_markup(self._format_transcript(entries)),
                              ("transcript", sid, len(entries)))

    def _render_selected(self):
        if not self.all_sessions:
            return
        s = self.all_sessions[self.selected_idx]
        proc = s.get("_proc") or {}
        self._render_agent_tree(s, proc)
        self._render_tasks(s)
        self._render_stats(s, proc)
        self._render_activity(s)
        self._render_footer(s, proc)

    # ── Agent Tree ───────────────────────────────────────────────────────

    def _render_agent_tree(self, s, proc):
        widget = self.query_one("#agent-tree", Static)
        lines = []

        cpu = proc.get("cpu", "0")
        elapsed = proc.get("elapsed", "—")
        try:
            cpu_f = float(cpu)
            if cpu_f > 20:   dot = "[bright_green]●[/]"
            elif cpu_f > 1:  dot = "[yellow]◐[/]"
            else:            dot = "[#585b70]○[/]"
        except ValueError:
            dot = "[#585b70]○[/]"

        summary = (s["summary"] or s["first_prompt"] or "Session")[:36]
        pid = proc.get("pid", "—")
        model = short_model(s["model"])

        # Main agent — elapsed right-aligned
        lines.append(f"  {dot} [b]Main Agent[/]                  [dim]{elapsed}[/]")

        has_kids = bool(s["subagents"])
        trunk = "│" if has_kids else " "
        lines.append(f"  {trunk}   [dim]{summary}[/]")
        lines.append(f"  {trunk}   [dim]PID {pid} · {model}[/]")

        mcps = proc.get("mcp_servers", [])
        if mcps:
            mcp_badges = " ".join(f"[bold on #45475a] {m} [/]" for m in mcps)
            lines.append(f"  {trunk}   {mcp_badges}")

        if has_kids:
            for i, sa in enumerate(s["subagents"]):
                is_last = (i == len(s["subagents"]) - 1)
                branch_ch = "└" if is_last else "├"
                connector = " " if is_last else "│"

                # Status dot + [RUNNING] badge
                if sa["status"] == "active":
                    sa_dot = "[bright_green]●[/]"
                    running = " [bold bright_green]\\[RUNNING][/]"
                elif sa["messages"] > 0:
                    sa_dot = "[green]✓[/]"
                    running = ""
                else:
                    sa_dot = "[#585b70]○[/]"
                    running = " [dim]pending[/]"

                task_short = sa.get("task", "")[:30]

                # Color-coded type badge
                badge = agent_badge(sa["type"])
                lines.append(
                    f"  {branch_ch}── {sa_dot} {badge}{running}"
                )
                if task_short:
                    lines.append(
                        f"  {connector}      [dim]{task_short}[/]"
                    )

                # Nested tool usage
                tools = sa["tools_used"][:4]
                if tools:
                    for j, tool in enumerate(tools):
                        is_tool_last = (j == len(tools) - 1)
                        t_ch = "└" if is_tool_last else "├"
                        tc = TOOL_COLOR.get(tool, "#cdd6f4")
                        lines.append(
                            f"  {connector}      {t_ch}── [green]✓[/] [{tc}]{tool}[/]"
                        )

        widget.update("\n".join(lines))

    # ── Tasks ────────────────────────────────────────────────────────────

    def _render_tasks(self, s):
        widget = self.query_one("#tasks-content", Static)
        lines = []

        if s["tasks"]:
            # ── Formal tasks from Claude's task system ────────────────
            completed = sum(1 for t in s["tasks"] if t["status"] == "completed")
            in_prog = sum(1 for t in s["tasks"] if t["status"] == "in_progress")
            pending = len(s["tasks"]) - completed - in_prog

            lines.append(
                f"  [green]{completed} done[/]  "
                f"[yellow]{in_prog} active[/]  "
                f"[dim]{pending} pending[/]"
            )
            lines.append("")

            for task in s["tasks"]:
                status = task["status"]
                subject = task["subject"][:42]
                active = task.get("active_form", "")
                blocked_by = task.get("blocked_by", [])

                if status == "completed":
                    lines.append(f"  [green]\\[✓][/] {subject}")
                elif status == "in_progress":
                    lines.append(
                        f"  [yellow]\\[→][/] {subject}  ← [yellow b]in-progress[/]"
                    )
                    if active:
                        lines.append(f"       [dim italic]{active}[/]")
                    if blocked_by:
                        lines.append(f"       [dim]blocked by: task {', '.join(blocked_by)}[/]")
                elif status == "blocked":
                    lines.append(
                        f"  [red]\\[✗][/] {subject}  ← [red]blocked[/]"
                    )
                    if blocked_by:
                        lines.append(f"       [dim]blocked by: task {', '.join(blocked_by)}[/]")
                else:
                    lines.append(f"  [#585b70]\\[ ][/] {subject}")

        elif s["steps"]:
            # ── Derived checklist from Agent calls + user messages ────
            # Deduplicate and show as checklist
            seen = set()
            steps = []
            for step in s["steps"]:
                key = step["text"][:30]
                if key not in seen:
                    seen.add(key)
                    steps.append(step)

            # Mark the last step as "in_progress" if session is active
            proc = s.get("_proc") or {}
            try:
                cpu_f = float(proc.get("cpu", "0"))
            except ValueError:
                cpu_f = 0
            is_active = cpu_f > 1

            for i, step in enumerate(steps):
                text = step["text"][:45]
                is_last_step = (i == len(steps) - 1)

                if is_last_step and is_active:
                    # Current step in progress
                    lines.append(
                        f"  [yellow]\\[→][/] {text}  ← [yellow b]in-progress[/]"
                    )
                else:
                    # Completed step
                    lines.append(f"  [green]\\[✓][/] {text}")

        else:
            # ── No tasks, no steps — show session summary ────────────
            summary = s["summary"] or s["first_prompt"]
            if summary:
                lines.append(f"  [green]\\[✓][/] {summary[:45]}")
            else:
                lines.append("  [dim]No activity yet[/]")

        widget.update("\n".join(lines))

    # ── Session Stats ────────────────────────────────────────────────────

    def _render_stats(self, s, proc):
        widget = self.query_one("#stats-content", Static)

        model = s["model"]
        model_short = short_model(model)
        t_in = s["input_tokens"] + s["cache_read"]
        t_out = s["output_tokens"]
        cost = calc_cost(s["input_tokens"], s["output_tokens"],
                         s["cache_read"], s["cache_write"], model)

        # Context bar
        ctx_window = 200_000
        ctx_pct = min(100, t_in / ctx_window * 100) if ctx_window else 0
        bar_w = 14
        filled = int(ctx_pct / 100 * bar_w)
        if ctx_pct < 50:     bc = "green"
        elif ctx_pct < 75:   bc = "yellow"
        elif ctx_pct < 90:   bc = "bright_red"
        else:                bc = "bold red"
        ctx_bar = f"[{bc}]{'█' * filled}[/][#45475a]{'█' * (bar_w - filled)}[/]"

        elapsed = proc.get("elapsed", "—")
        active_agents = sum(1 for sa in s["subagents"] if sa["status"] == "active")
        total_agents = len(s["subagents"])

        try:
            cpu_f = float(proc.get("cpu", "0"))
        except ValueError:
            cpu_f = 0
        self.cpu_history.append(cpu_f)
        if len(self.cpu_history) > 40:
            self.cpu_history = self.cpu_history[-40:]
        spark = build_spark(self.cpu_history)

        lines = [
            "",
            f"  [b]Model[/]       [cyan]{model_short}[/]",
            f"  [b]Context[/]     {ctx_bar} {ctx_pct:.1f}%",
            f"  [b]Tokens In[/]   {fmt_tokens(s['input_tokens'])}",
            f"  [b]Tokens Out[/]  {fmt_tokens(t_out)}",
            f"  [b]Cache Read[/]  {fmt_tokens(s['cache_read'])}",
            f"  [b]Cache Write[/] {fmt_tokens(s['cache_write'])}",
            f"  [b]Cost[/]        [bold red]{fmt_cost(cost)}[/]",
            f"  [b]Agents[/]      {total_agents} ({active_agents} active)",
            f"  [b]Duration[/]    {elapsed}",
            "",
            f"  [dim]CPU[/] [bright_green]{spark}[/]",
        ]

        gstats = get_global_stats()
        if gstats:
            mu = gstats.get("modelUsage", {})
            all_cost = sum(
                calc_cost(v.get("inputTokens",0), v.get("outputTokens",0),
                          v.get("cacheReadInputTokens",0), v.get("cacheCreationInputTokens",0), k)
                for k, v in mu.items()
            )
            lines.append(f"  [dim]All-time:[/] [bold]{fmt_cost(all_cost)}[/]")

        widget.update("\n".join(lines))

    # ── Activity Log ─────────────────────────────────────────────────────

    def _render_activity(self, s):
        widget = self.query_one("#activity-content", Static)
        lines = []

        recent = s["activity"][-self.log_lines:]
        if not recent:
            lines.append("  [dim]No recent activity[/]")
        else:
            for act in recent:
                time_str = act["time"] or "        "
                agent = act["agent"]
                tool = act["tool"]
                detail = act["detail"]

                # Color-coded agent badge
                ac = agent_color(agent)
                agent_str = f"[bold {ac}]\\[{agent:>7}][/]"

                # Status sphere per line
                if act["is_side"]:
                    sphere = f"[{ac}]●[/]"
                else:
                    sphere = "[cyan]●[/]"

                # Tool with color
                tc = TOOL_COLOR.get(tool, "#cdd6f4")
                tool_str = f"[{tc}]Tool:{tool:<10}[/]"

                lines.append(
                    f"  {sphere} [dim]{time_str}[/]  {agent_str}  {tool_str} {detail}"
                )

        widget.update("\n".join(lines))

    # ── Footer ───────────────────────────────────────────────────────────

    def _render_footer(self, s, proc):
        widget = self.query_one("#footer-bar", Static)

        cpu = proc.get("cpu", "0")
        try:
            cpu_f = float(cpu)
        except ValueError:
            cpu_f = 0

        if s["activity"]:
            last = s["activity"][-1]
            if cpu_f > 5:
                widget.update(
                    f"[#1e1e2e]→ {last['time']} "
                    f"\\[{last['agent']}] Tool:{last['tool']}  {last['detail'][:50]}[/]"
                )
            else:
                widget.update(
                    f"[#1e1e2e]→ Waiting for input… │ "
                    f"Last: {last['tool']}  {last['detail'][:40]}[/]"
                )
        else:
            widget.update("[#1e1e2e]→ Session idle[/]")


