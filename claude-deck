    BINDINGS = [
        ("q", "quit", "Quit"),
        ("r", "refresh", "Refresh"),
        ("j", "jump_current", "Jump"),
        ("n", "new_chat", "New chat"),
        ("p", "toggle_pin", "Pin"),
        ("R", "toggle_resume", "Resume list"),
        ("m", "toggle_view", "Mirror/Transcript"),
        ("i", "attach_image", "Attach image"),
        ("escape", "back", "Back"),
        ("l", "cycle_log", "Log"),
    ]

    def __init__(self):
        super().__init__()
        self.cpu_history = []
        self.all_sessions = []
        self.all_processes = []
        self.selected_idx = 0
        self.log_lines = 10
        self.focus_sid = None          # session id being viewed in the focus pane
        self.focus_view = "mirror"     # "mirror" | "transcript"
        self.pins = load_pins()        # pinned session ids (persisted)
        self.resume_mode = False       # list shows ALL conversations when True
        self.resume_metas = []         # cached scan of all sessions (resume mode)
        self.sid_files = {}            # sid -> (filepath, account) for any listed session
        self.name_by_sid = {}          # sid -> clean session name (e.g. 'fusion-753')
        self._last_click_sid = None    # for single- vs double-click detection
        self._last_click_time = 0.0
        self._mouse_click_at = 0.0     # last real mouse click (vs keyboard Enter)
        self._focus_sig = None         # chat content signature for auto-scroll
        self.pending_images = []        # image paths queued to send with the next message
        self.hosted = None              # a HostedSession the deck runs itself (new chat)
        self.term = None                # a TerminalPane (real interactive claude)

    def compose(self) -> ComposeResult:
        yield Static("⬡  CLAUDE DECK | MULTI-ACCOUNT CONTROL", id="header-bar")

        tree_panel = VerticalScroll(Static("", id="agent-tree"), id="agent-tree-panel")
        tree_panel.border_title = "Agent Tree"

        tasks_panel = VerticalScroll(Static("", id="tasks-content"), id="tasks-panel")
        tasks_panel.border_title = "Tasks"

        stats_panel = Vertical(Static("", id="stats-content"), id="stats-panel")
        stats_panel.border_title = "Session Stats"

        recent_panel = Vertical(ListView(id="recent-tasks"), id="recent-panel")
        recent_panel.border_title = "Conversations"

        focus_panel = Vertical(
            Horizontal(
                Button("← Back", id="focus-back", variant="primary"),
                Button("View: Mirror", id="focus-toggle"),
