                Static("", id="focus-title"),
                id="focus-toolbar",
            ),
            VerticalScroll(Static("", id="focus-content"), id="focus-scroll"),
            ChatInput(soft_wrap=True, id="focus-input",
                      placeholder="Type a message and press Enter — "
                                  "Shift+Enter for a newline · paste/drag images or i to attach"),
            id="focus-panel",
        )
        focus_panel.border_title = "Conversation"

