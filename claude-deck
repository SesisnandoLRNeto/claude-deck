# ── iTerm2 jump-by-TTY ────────────────────────────────────────────────────────

JUMP_APPLESCRIPT = r'''
on run argv
    set targetTTY to item 1 of argv
    tell application "iTerm2"
        repeat with w in windows
            repeat with t in tabs of w
                repeat with s in sessions of t
                    if (tty of s) is targetTTY then
                        select w
                        tell t to select
                        tell s to select
                        activate
                        return "OK"
                    end if
                end repeat
            end repeat
        end repeat
    end tell
    return "NOMATCH"
end run
'''


def jump_to_tty(proc_tty):
    """Focus the iTerm2 tab/pane whose tty matches. proc_tty is the ps column
    like 'ttys006' (no /dev/). Returns True only on a confirmed focus."""
    if not proc_tty or proc_tty in ("??", "?"):
        return False
    full = proc_tty if proc_tty.startswith("/dev/") else f"/dev/{proc_tty}"
    try:
        r = subprocess.run(["osascript", "-e", JUMP_APPLESCRIPT, full],
                           capture_output=True, text=True, timeout=5)
        return r.returncode == 0 and r.stdout.strip() == "OK"
    except Exception:
        return False


# Reads the visible screen text of a session WITHOUT activating it (no focus
# steal). Returns the plain on-screen text for the mirror panel.
MIRROR_APPLESCRIPT = r'''
on run argv
    set targetTTY to item 1 of argv
    tell application "iTerm2"
        repeat with w in windows
            repeat with t in tabs of w
                repeat with s in sessions of t
                    if (tty of s) is targetTTY then
                        return (text of s)
                    end if
                end repeat
            end repeat
        end repeat
    end tell
    return ""
end run
'''


def get_session_screen(proc_tty):
    """Live screen text of the iTerm2 session on this tty, or None."""
    if not proc_tty or proc_tty in ("??", "?"):
        return None
    full = proc_tty if proc_tty.startswith("/dev/") else f"/dev/{proc_tty}"
    try:
        r = subprocess.run(["osascript", "-e", MIRROR_APPLESCRIPT, full],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout
    except Exception:
        pass
    return None


# Sends text to a session (as if typed). `write text` appends a newline, so the
# message is submitted — this is how the embedded input box talks to a session.
WRITE_APPLESCRIPT = r'''
on run argv
    set targetTTY to item 1 of argv
    set theText to item 2 of argv
    tell application "iTerm2"
        repeat with w in windows
            repeat with t in tabs of w
                repeat with s in sessions of t
                    if (tty of s) is targetTTY then
                        tell s to write text theText
                        return "OK"
                    end if
                end repeat
            end repeat
        end repeat
    end tell
    return "NOMATCH"
end run
'''


def send_text_to_tty(proc_tty, text):
    """Type `text` into the iTerm2 session on this tty and submit it."""
    if not proc_tty or proc_tty in ("??", "?"):
        return False
    full = proc_tty if proc_tty.startswith("/dev/") else f"/dev/{proc_tty}"
    try:
        r = subprocess.run(["osascript", "-e", WRITE_APPLESCRIPT, full, text],
                           capture_output=True, text=True, timeout=5)
        return r.returncode == 0 and r.stdout.strip() == "OK"
    except Exception:
        return False


# Permission posture for hosted sessions. acceptEdits = auto-accept file edits,
# but the agent will not run shell commands on its own. Set the env var to
# "bypassPermissions" for a fully autonomous agent (powerful and riskier).
HOSTED_PERMISSION_MODE = os.environ.get("CLAUDE_DECK_PERMISSION_MODE", "acceptEdits")
HOSTED_CLAUDE_BIN = os.environ.get("CLAUDE_DECK_CLAUDE_BIN", "claude")


class HostedSession:
    """A Claude Code session the deck runs and owns itself — no iTerm2 involved.
    Spawns `claude` in headless stream-json mode and talks to it over pipes."""

    def __init__(self, account=None, cwd=None, permission_mode=HOSTED_PERMISSION_MODE):
        self.account = account
        self.cwd = cwd if (cwd and os.path.isdir(cwd)) else None
        self.permission_mode = permission_mode
        self.entries = []          # (role, text) for the transcript renderer
        self.queue = queue.Queue()  # lines from the reader thread (None = EOF)
        self.proc = None
        self.alive = False
        self.status = "starting"
        self.display_name = "new chat"
        self._stderr = []

    def start(self):
        env = dict(os.environ)
        path = self.account.get("path") if self.account else None
        if path and Path(path) != (Path.home() / ".claude"):
            env["CLAUDE_CONFIG_DIR"] = str(path)
        cmd = [HOSTED_CLAUDE_BIN, "--print",
               "--input-format", "stream-json",
               "--output-format", "stream-json",
               "--verbose", "--permission-mode", self.permission_mode]
        try:
            self.proc = subprocess.Popen(
                cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True, bufsize=1, env=env, cwd=self.cwd)
        except Exception as e:
            self.status = "error"
            self._stderr.append(str(e))
            return False
        self.alive = True
        self.status = "ready"
        threading.Thread(target=self._read, args=(self.proc.stdout,), daemon=True).start()
        threading.Thread(target=self._read_err, args=(self.proc.stderr,), daemon=True).start()
        return True

    def _read(self, stream):
        for line in stream:
            line = line.strip()
            if line:
                self.queue.put(line)
        self.alive = False
        self.queue.put(None)

    def _read_err(self, stream):
        for line in stream:
            if line.strip():
                self._stderr.append(line.strip())

    def send(self, text):
        if not self.alive or not self.proc or not self.proc.stdin:
            return False
        msg = {"type": "user",
               "message": {"role": "user", "content": [{"type": "text", "text": text}]}}
        try:
            self.proc.stdin.write(json.dumps(msg) + "\n")
            self.proc.stdin.flush()
            self.entries.append(("user", text))
            self.status = "working"
            return True
        except Exception:
            self.alive = False
            return False

    def drain(self):
        """Pull queued events on the UI thread. Returns True if anything changed."""
        changed = False
        while True:
            try:
                line = self.queue.get_nowait()
            except queue.Empty:
                break
            changed = True
            if line is None:
                self.status = "ended"
                if not any(r == "assistant" for r, _ in self.entries) and self._stderr:
                    self.entries.append(("error", "\n".join(self._stderr[-8:])))
                continue
            for ev in self._parse(line):
                self.entries.append(ev)
        return changed

    def _parse(self, line):
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            return []
        t = msg.get("type")
        out = []
        if t == "assistant":
            for b in msg.get("message", {}).get("content", []):
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    out.append(("assistant", b["text"]))
                elif b.get("type") == "tool_use":
                    out.append(("tool", f'{b.get("name", "")}  {_tool_detail(b.get("input", {}))}'.strip()))
        elif t == "result":
            self.status = "idle"
        elif t == "system" and msg.get("subtype") == "init":
            self.status = "idle"
        return out

    def close(self):
        self.alive = False
        if self.proc:
            try:
                if self.proc.stdin:
                    self.proc.stdin.close()
            except Exception:
                pass
            try:
                self.proc.terminate()
            except Exception:
                pass


IMG_EXT = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".heic", ".tiff", ".svg")


def extract_image_paths(text):
    """Pull image file paths out of a message (e.g. dropped onto the input by
    iTerm2, which inserts space-separated, possibly backslash-escaped paths).
    Returns (image_paths, remaining_text). Cheap no-op when there's no image."""
    low = text.lower()
    if not any(ext in low for ext in IMG_EXT):
        return [], text
    try:
        tokens = shlex.split(text)
    except ValueError:
        tokens = text.split()
    imgs, rest = [], []
    for t in tokens:
        p = os.path.expanduser(t)
        if p.lower().endswith(IMG_EXT) and os.path.isfile(p):
            imgs.append(p)
        else:
            rest.append(t)
    return imgs, " ".join(rest)


def clipboard_image_to_file():
    """If the clipboard holds an image, write it to a temp PNG and return its
    path (so it can be sent to a session as an image reference). Else None."""
    fd, path = tempfile.mkstemp(prefix="cm-clip-", suffix=".png")
    os.close(fd)
    script = (
        'set theFile to (open for access POSIX file "%s" with write permission)\n'
        'try\n'
        '    write (the clipboard as «class PNGf») to theFile\n'
        '    close access theFile\n'
        '    return "OK"\n'
        'on error\n'
        '    try\n'
        '        close access theFile\n'
        '    end try\n'
        '    return "NOIMG"\n'
        'end try\n'
    ) % path
    try:
        r = subprocess.run(["osascript", "-e", script],
                           capture_output=True, text=True, timeout=5)
        if (r.returncode == 0 and r.stdout.strip() == "OK"
                and os.path.exists(path) and os.path.getsize(path) > 0):
            return path
    except Exception:
        pass
    try:
        os.remove(path)
    except OSError:
        pass
    return None


# ── Data Collection ──────────────────────────────────────────────────────────

def get_claude_processes():
    try:
        result = subprocess.run(["ps", "-eo", "pid,ppid,%cpu,%mem,etime,tty,command"],
                                capture_output=True, text=True)
    except Exception:
        return []

    processes = []
    for line in result.stdout.strip().split("\n")[1:]:
        parts = line.split()
        if len(parts) >= 7 and parts[-1] == "claude":
            pid = int(parts[0])
            cpu = parts[2].replace(",", ".")
            mem = parts[3].replace(",", ".")
            cwd = _get_cwd(pid)
            mcp_servers = _get_mcp_servers(pid)
            processes.append({
                "pid": pid, "cpu": cpu, "mem": mem,
                "elapsed": parts[4], "tty": parts[5],
                "cwd": cwd, "mcp_servers": mcp_servers,
                "account": None, "session_id": "", "sess_status": "",
            })
    return processes


def build_pid_index(config_dirs=CONFIG_DIRS):
    """Map live PID -> {account, sessionId, cwd, name, status} via
    <configdir>/sessions/<pid>.json. The account is known from which dir owns
    the file. These files are stale-prone — use only for lookup, never liveness."""
    idx = {}
    for acct in config_dirs:
        for fp in glob.glob(str(acct["path"] / "sessions" / "*.json")):
            try:
                with open(fp) as f:
                    d = json.load(f)
            except Exception:
                continue
            pid = d.get("pid")
            if pid is None:
                try:
                    pid = int(Path(fp).stem)
                except ValueError:
                    continue
            idx[pid] = {
                "account": acct,
                "sessionId": d.get("sessionId", ""),
                "cwd": d.get("cwd", ""),
                "name": d.get("name", ""),
                "status": d.get("status", ""),
            }
    return idx


def tag_processes(processes, pid_index):
    """Attach account / sessionId / disk-status to each live process dict."""
    for p in processes:
        info = pid_index.get(p["pid"], {})
        p["account"] = info.get("account")
        p["session_id"] = info.get("sessionId", "")
        p["sess_status"] = info.get("status", "")
        if (not p.get("cwd") or p["cwd"] == "unknown") and info.get("cwd"):
            p["cwd"] = info["cwd"]
    return processes


def _get_cwd(pid):
    try:
        r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=5)
        for line in r.stdout.split("\n"):
            if line.startswith("n/"): return line[1:]
    except Exception: pass
    return "unknown"


def _get_mcp_servers(pid):
    servers = []
    try:
        children = subprocess.run(["pgrep", "-P", str(pid)],
                                  capture_output=True, text=True, timeout=3).stdout.strip().split("\n")
        for cpid_str in children:
            if not cpid_str: continue
            cmd = subprocess.run(["ps", "-p", cpid_str, "-o", "command="],
                                 capture_output=True, text=True, timeout=3).stdout.strip()
            if "mcp-atlassian" in cmd:   servers.append("Jira")
            elif "server-github" in cmd: servers.append("GitHub")
            elif "mcp-" in cmd:          servers.append(cmd.split("mcp-")[-1].split()[0].title())
    except Exception: pass
    return servers


def get_active_sessions(n_expected, config_dirs=CONFIG_DIRS, max_age_min=120):
    """Return [(filepath, account), ...] across all accounts, newest first."""
    now = time.time()
    candidates = []
    for acct in config_dirs:
        for fp in glob.glob(str(acct["path"] / "projects" / "*" / "*.jsonl")):
            try:
                age_min = (now - os.path.getmtime(fp)) / 60
            except OSError:
                continue
            if age_min < max_age_min:
                candidates.append((age_min, fp, acct))
    candidates.sort(key=lambda c: c[0])
    return [(fp, acct) for _, fp, acct in candidates[:max(n_expected, 5)]]


def find_session_file(account, sid):
    """Locate a session's jsonl under an account, ignoring the age window.
    Used so live sessions always show even if idle for hours."""
    hits = glob.glob(str(account["path"] / "projects" / "*" / f"{sid}.jsonl"))
    return hits[0] if hits else None


def fp_sid(filepath):
    """Session id from a jsonl path."""
    return os.path.basename(filepath).replace(".jsonl", "")


def find_session_file_any(sid, config_dirs=CONFIG_DIRS):
    """Find a session's file across all accounts -> (filepath, account) or None."""
    for acct in config_dirs:
        fp = find_session_file(acct, sid)
        if fp:
            return fp, acct
    return None


def _read_tail(path, nbytes=131072):
    """Read the last nbytes of a file as text (for cheap name lookups)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - nbytes))
            return f.read().decode("utf-8", "replace")
    except Exception:
        return ""


_NAME_RE = re.compile(r'"(?:customTitle|agentName)":"((?:[^"\\]|\\.)*)"')


def scan_session_meta(filepath, account):
    """Cheap metadata for the resume list. Reads the HEAD for branch + first
    prompt, and the TAIL for the clean session name (custom-title / agent-name
    records live deep in the file and persist near the end)."""
    sid = os.path.basename(filepath).replace(".jsonl", "")
    title, branch = "", ""
    try:
        with open(filepath) as f:
            for i, line in enumerate(f):
                if i > 50:
                    break
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not branch and msg.get("gitBranch"):
                    branch = msg["gitBranch"]
                if msg.get("type") == "summary" and msg.get("summary"):
                    title = msg["summary"]
                if not title and msg.get("type") == "user":
                    txt = _msg_text(msg.get("message", {}).get("content", "")).strip()
                    head = txt[:40]
                    if txt and not (txt.startswith("<") and any(
                            k in head for k in ("local-command", "system-reminder",
                                                "ide_", "command-"))):
                        title = txt
    except Exception:
        pass
    # The clean name (e.g. "ps-4412") — last occurrence in the file's tail.
    matches = _NAME_RE.findall(_read_tail(filepath))
    name = ""
    if matches:
        try:
            name = json.loads('"' + matches[-1] + '"')
        except Exception:
            name = matches[-1]
    try:
        mtime = os.path.getmtime(filepath)
    except OSError:
        mtime = 0
    return {"session_id": sid, "filepath": filepath, "account": account,
            "name": name, "title": " ".join((title or sid).split()),
            "branch": branch, "mtime": mtime}


def list_all_sessions(config_dirs=CONFIG_DIRS, cap=200):
    """All conversations across every account, newest first (capped)."""
    files = []
    for acct in config_dirs:
        for fp in glob.glob(str(acct["path"] / "projects" / "*" / "*.jsonl")):
            try:
                files.append((os.path.getmtime(fp), fp, acct))
            except OSError:
                continue
    files.sort(key=lambda x: x[0], reverse=True)
    return [scan_session_meta(fp, acct) for _, fp, acct in files[:cap]]


def parse_session(filepath, account=None):
    sid = os.path.basename(filepath).replace(".jsonl", "")
    stats = {
        "session_id": sid, "filepath": filepath,
        "account": account,
        "model": "unknown", "git_branch": "",
        "input_tokens": 0, "output_tokens": 0,
        "cache_read": 0, "cache_write": 0,
        "messages": 0, "user_messages": 0, "tool_calls": 0,
        "summary": "", "first_prompt": "", "name": "",
        "subagents": [], "activity": [], "tasks": [],
        "steps": [],  # derived checklist from user msgs + Agent calls
        "start_time": None,
    }

    try:
        with open(filepath) as f:
            for line in f:
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue
                t = msg.get("type")

                if not stats["git_branch"] and msg.get("gitBranch"):
                    stats["git_branch"] = msg["gitBranch"]
                if not stats["start_time"] and msg.get("timestamp"):
                    stats["start_time"] = msg["timestamp"]

                if t == "assistant":
                    stats["messages"] += 1
                    m = msg.get("message", {})
                    model = m.get("model", "")
                    if model: stats["model"] = model
                    u = m.get("usage", {})
                    stats["input_tokens"] += u.get("input_tokens", 0)
                    stats["output_tokens"] += u.get("output_tokens", 0)
                    stats["cache_read"] += u.get("cache_read_input_tokens", 0)
                    stats["cache_write"] += u.get("cache_creation_input_tokens", 0)

                    ts = msg.get("timestamp", "")
                    is_side = msg.get("isSidechain", False)

                    for block in m.get("content", []):
                        if isinstance(block, dict) and block.get("type") == "tool_use":
                            stats["tool_calls"] += 1
                            tool_name = block.get("name", "")
                            inp = block.get("input", {})
                            detail = ""
                            if "command" in inp:
                                detail = inp["command"].split("\n")[0][:50]
                            elif "file_path" in inp:
                                detail = shorten_path(inp["file_path"])
                            elif "pattern" in inp:
                                p = inp["pattern"]
                                path = inp.get("path", "")
                                detail = f'"{p}"' + (f" in {shorten_path(path)}" if path else "")
                                detail = detail[:50]
                            elif "prompt" in inp:
                                detail = inp.get("description", inp["prompt"][:40])
                            elif "skill" in inp:
                                detail = inp["skill"]

                            agent_label = "Main" if not is_side else "Agent"
                            time_str = ts.split("T")[1][:8] if "T" in ts else ""
                            stats["activity"].append({
                                "time": time_str, "agent": agent_label,
                                "tool": tool_name, "detail": detail[:60],
                                "is_side": is_side,
                            })

                            # Capture Agent tool calls as steps
                            if tool_name == "Agent" and not is_side:
                                desc = inp.get("description", "")
                                if desc:
                                    stats["steps"].append({
                                        "text": desc[:55],
                                        "status": "completed",
                                    })

                elif t == "user":
                    stats["user_messages"] += 1
                    if not stats["first_prompt"]:
                        content = msg.get("message", {}).get("content", "")
                        if isinstance(content, list):
                            for c in content:
                                if isinstance(c, dict) and c.get("type") == "text":
                                    content = c["text"]
                                    break
                        text = str(content).strip()
                        if text.startswith("<local-command") or text.startswith("<ide_") or text.startswith("<command"):
                            real = re.split(r'</[^>]+>', text)
                            for chunk in real:
                                chunk = chunk.strip()
                                if chunk and not chunk.startswith("<"):
                                    stats["first_prompt"] = chunk[:80]
                                    break
                        else:
                            stats["first_prompt"] = text[:80]

                    # Capture real user messages as conversation steps
                    if stats["first_prompt"] and stats["user_messages"] > 0:
                        content = msg.get("message", {}).get("content", "")
                        if isinstance(content, str) and not content.startswith("<") and not content.startswith("[{"):
                            step_text = content.strip()[:55]
                            if step_text and len(step_text) > 5:
                                stats["steps"].append({
                                    "text": step_text,
                                    "status": "completed",
                                })

                elif t == "summary":
                    stats["summary"] = msg.get("summary", "")

                elif t == "custom-title" and msg.get("customTitle"):
                    stats["name"] = msg["customTitle"]
                elif t == "agent-name" and msg.get("agentName"):
                    stats["name"] = msg["agentName"]

    except Exception:
        pass

    # ── Subagents ────────────────────────────────────────────────────────
    subdir = Path(filepath).parent / sid / "subagents"
    if subdir.is_dir():
        for meta_file in subdir.glob("*.meta.json"):
            try:
                with open(meta_file) as mf:
                    meta = json.load(mf)
                agent_id = meta_file.stem.replace(".meta", "")
                agent_type = meta.get("agentType", "?")
                jsonl_file = subdir / f"{agent_id}.jsonl"
                sa = {"id": agent_id[:16], "type": agent_type,
                      "model": "", "tokens_in": 0, "tokens_out": 0,
                      "messages": 0, "task": "", "tool_calls": 0,
                      "status": "done", "tools_used": []}

                if jsonl_file.exists():
                    file_age = (time.time() - os.path.getmtime(str(jsonl_file))) / 60
                    if file_age < 2:
                        sa["status"] = "active"

                    with open(jsonl_file) as af:
                        for aline in af:
                            try:
                                amsg = json.loads(aline)
                                if amsg.get("type") == "user" and not sa["task"]:
                                    content = amsg.get("message", {}).get("content", "")
                                    if isinstance(content, list):
                                        for c in content:
                                            if isinstance(c, dict) and c.get("type") == "text":
                                                content = c["text"]
                                                break
                                    task = str(content).strip()
                                    if task.startswith("Your task is to create a detailed summary"):
                                        sa["task"] = "Context compression / summarization"
                                    else:
                                        sa["task"] = task[:100]
                                elif amsg.get("type") == "assistant":
                                    sa["messages"] += 1
                                    am = amsg.get("message", {})
                                    if am.get("model"): sa["model"] = am["model"]
                                    au = am.get("usage", {})
                                    sa["tokens_in"] += au.get("input_tokens", 0) + au.get("cache_read_input_tokens", 0)
                                    sa["tokens_out"] += au.get("output_tokens", 0)
                                    for block in am.get("content", []):
                                        if isinstance(block, dict) and block.get("type") == "tool_use":
                                            sa["tool_calls"] += 1
                                            tn = block.get("name", "")
                                            if tn and tn not in sa["tools_used"]:
                                                sa["tools_used"].append(tn)
                                            inp = block.get("input", {})
                                            detail = ""
                                            if "file_path" in inp: detail = shorten_path(inp["file_path"])
                                            elif "pattern" in inp: detail = f'"{inp["pattern"]}"'[:30]
                                            elif "command" in inp: detail = inp["command"].split("\n")[0][:40]
                                            ts_a = amsg.get("timestamp", "")
                                            time_str = ts_a.split("T")[1][:8] if "T" in ts_a else ""
                                            stats["activity"].append({
                                                "time": time_str, "agent": agent_type[:7],
                                                "tool": tn, "detail": detail[:55],
                                                "is_side": True,
                                            })
                            except json.JSONDecodeError:
                                continue
                stats["subagents"].append(sa)
            except Exception:
                continue

    # ── Tasks ────────────────────────────────────────────────────────────
    acct_dir = account["path"] if account else CLAUDE_DIR
    tasks_dir = acct_dir / "tasks" / sid
    if tasks_dir.is_dir():
        for tf in sorted(tasks_dir.glob("*.json"), key=lambda f: int(f.stem) if f.stem.isdigit() else 0):
            try:
                with open(tf) as fh:
                    task = json.load(fh)
                stats["tasks"].append({
                    "id": task.get("id", ""),
                    "subject": task.get("subject", ""),
                    "status": task.get("status", "pending"),
                    "active_form": task.get("activeForm", ""),
                    "blocked_by": task.get("blockedBy", []),
                    "blocks": task.get("blocks", []),
                })
            except Exception:
                continue

    stats["activity"].sort(key=lambda a: a["time"])
    return stats


def get_global_stats(config_dirs=CONFIG_DIRS):
    """Merge stats-cache.json across all accounts (sum modelUsage key-by-key)."""
    merged = {}
    found = False
    for acct in config_dirs:
        sf = acct["path"] / "stats-cache.json"
        if not sf.exists():
            continue
        try:
            with open(sf) as f:
                data = json.load(f)
        except Exception:
            continue
        found = True
        for model, usage in data.get("modelUsage", {}).items():
            agg = merged.setdefault(model, {})
            for k, v in usage.items():
                if isinstance(v, (int, float)):
                    agg[k] = agg.get(k, 0) + v
    return {"modelUsage": merged} if found else None


# ── Recent Tasks (cross-account) ──────────────────────────────────────────────

def session_label(sid, session, name_by_sid):
    """A clean, human name for a session: its Claude session name (e.g.
    'fusion-753', 'padmdrac-2') when known, else git branch, else cwd, else id."""
    name = (name_by_sid or {}).get(sid) or (session or {}).get("name")
    if name:
        return name
    branch = (session or {}).get("git_branch", "")
    if branch and branch != "HEAD":
        return branch
    cwd = ((session or {}).get("_proc") or {}).get("cwd", "")
    if cwd:
        return os.path.basename(cwd.rstrip("/")) or shorten_path(cwd)
    return sid[:8]


def build_recent_rows(sessions, pins=frozenset(), name_by_sid=None):
    """Flatten parsed sessions into render-ready rows. Pinned first, then newest.
    `sessions` already carry `_proc` (live process or None) and `account`."""
    rows = []
    for s in sessions:
        proc = s.get("_proc")
        live = proc is not None
        acct = s.get("account") or {"name": "?", "color": "#585b70"}
        try:
            mtime = os.path.getmtime(s["filepath"])
        except OSError:
            mtime = 0

        if live:
            status = proc.get("sess_status") or "idle"
        else:
            status = "ended"

        label = " ".join(session_label(s["session_id"], s, name_by_sid).split())[:48]
        summary = (s["summary"] or s["first_prompt"] or "—")
        # Collapse whitespace so a one-line row never wraps or grows in height.
        summary = " ".join(summary.split())[:48]
        cost = calc_cost(s["input_tokens"], s["output_tokens"],
                         s["cache_read"], s["cache_write"], s["model"])

        rows.append({
            "key": s["session_id"],
            "mtime": mtime,
            "account": acct,
            "live": live,
            "tty": (proc or {}).get("tty", ""),
            "status": status,
            "label": label or "~",
            "summary": summary,
            "cost": cost,
            "tokens": s["input_tokens"] + s["cache_read"],
            "pinned": s["session_id"] in pins,
        })
    # Pinned first, then most recent.
    rows.sort(key=lambda r: (not r["pinned"], -r["mtime"]))
    return rows


def build_resume_rows(metas, live_by_sid, pins=frozenset(), name_by_sid=None):
    """Render-ready rows for the resume (all conversations) list. `live_by_sid`
    maps a session id to its live process dict, if any."""
    name_by_sid = name_by_sid or {}
    rows = []
    for m in metas:
        sid = m["session_id"]
        proc = live_by_sid.get(sid)
        live = proc is not None
        acct = m["account"] or {"name": "?", "color": "#585b70"}
        status = (proc.get("sess_status") or "idle") if live else "ended"
        name = name_by_sid.get(sid) or m.get("name") or ""
        if not name:
            br = m["branch"] or ""
            name = br if br and br != "HEAD" else ""
        label = " ".join(name.split())[:48] or "~"
        rows.append({
            "key": sid,
            "mtime": m["mtime"],
            "account": acct,
            "live": live,
            "tty": (proc or {}).get("tty", ""),
            "status": status,
            "label": label,
            "summary": m["title"][:48] or "—",
            "cost": 0.0,
            "tokens": 0,
            "pinned": sid in pins,
        })
    rows.sort(key=lambda r: (not r["pinned"], -r["mtime"]))
    return rows


def recent_row_markup(r, n):
    """One row for the Recent / Resume list. Ended rows are dimmed."""
    acct = r["account"]
    pin = "[yellow]★[/]" if r.get("pinned") else " "

    if r["status"] == "busy":   dot = "[bright_green]●[/]"
    elif r["status"] == "idle": dot = "[yellow]◐[/]"
    else:                       dot = "[#585b70]○[/]"

    label = rich_escape(r["label"][:20])
    summary = rich_escape(r["summary"][:30])
    # Metrics only when we have them (resume rows carry 0/0 — show blanks).
    metrics = ""
    if r["tokens"] or r["cost"]:
        metrics = (f"[dim]{fmt_tokens(r['tokens']):>6}[/] "
                   f"[red]{fmt_cost(r['cost']):>7}[/]")
    if r["live"]:
        badge = f"[bold on {acct['color']}] {acct['name'][:4]:<4} [/]"
        return (f"{pin}[dim]{n:>2}[/] {dot} {badge} "
                f"[#89b4fa]{label:<20}[/] "
                f"{summary:<30} {metrics} [green]↵[/]")
    return (f"{pin}[dim]{n:>2}[/] {dot} [dim on {acct['color']}] {acct['name'][:4]:<4} [/] "
            f"[dim #6c7086]{label:<20}[/] "
            f"[dim #6c7086]{summary:<30}[/] {metrics}  ")


def _msg_text(content):
    """Pull plain text out of a message content (str or list of blocks)."""
    if isinstance(content, list):
        for c in content:
            if isinstance(c, dict) and c.get("type") == "text":
                return c.get("text", "")
        return ""
    return str(content or "")


def _tool_detail(inp):
    if "command" in inp:   return inp["command"].split("\n")[0][:60]
    if "file_path" in inp: return shorten_path(inp["file_path"])
    if "pattern" in inp:   return f'"{inp["pattern"]}"'[:50]
    if "description" in inp: return inp["description"][:60]
    if "skill" in inp:     return inp["skill"]
    return ""


def build_transcript(filepath, tail=80):
    """Reconstruct a readable conversation from a session jsonl: ordered
    (role, text) entries for user prompts, assistant text, and tool calls."""
    entries = []
    try:
        with open(filepath) as f:
            for line in f:
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue
                t = msg.get("type")
                if t == "user":
                    text = _msg_text(msg.get("message", {}).get("content", "")).strip()
                    if not text:
                        continue
                    head = text[:40]
                    if text.startswith("<") and any(k in head for k in
                            ("local-command", "system-reminder", "ide_", "command-")):
                        continue
                    entries.append(("user", text))
                elif t == "assistant":
                    for block in msg.get("message", {}).get("content", []):
                        if not isinstance(block, dict):
                            continue
                        if block.get("type") == "text":
                            txt = block.get("text", "").strip()
                            if txt:
                                entries.append(("assistant", txt))
                        elif block.get("type") == "tool_use":
                            name = block.get("name", "")
                            detail = _tool_detail(block.get("input", {}))
                            entries.append(("tool", f"{name}  {detail}".strip()))
    except Exception:
        pass
    return entries[-tail:]


class ChatInput(TextArea):
    """Multi-line chat box that soft-wraps and grows with its content. Enter
    sends the message; Shift+Enter (or Ctrl+J) inserts a newline."""

    class Submitted(Message):
        def __init__(self, text):
            self.text = text
            super().__init__()

    NEWLINE_KEYS = ("shift+enter", "ctrl+j")

    def _on_key(self, event):
        if event.key == "escape":
            return  # let it bubble up to the app (Back) instead of capturing it
        if event.key in self.NEWLINE_KEYS:
            event.prevent_default()
            event.stop()
            self.insert("\n")
            return
        if event.key == "enter":
            event.prevent_default()
            event.stop()
            self.post_message(self.Submitted(self.text))
            return
        super()._on_key(event)


_PYTE_COLORS = {
    "black": "black", "red": "red", "green": "green", "brown": "yellow",
    "blue": "blue", "magenta": "magenta", "cyan": "cyan", "white": "white",
    "brightblack": "bright_black", "brightred": "bright_red",
    "brightgreen": "bright_green", "brightyellow": "bright_yellow",
    "brightblue": "bright_blue", "brightmagenta": "bright_magenta",
    "brightcyan": "bright_cyan", "brightwhite": "bright_white",
}


def _pyte_color(c):
    if not c or c == "default":
        return None
    if c in _PYTE_COLORS:
        return _PYTE_COLORS[c]
    if len(c) == 6 and all(ch in "0123456789abcdefABCDEF" for ch in c):
        return "#" + c
    return c


class TerminalPane(Widget, can_focus=True):
    """A real pseudo-terminal embedded in the deck. Runs an interactive program
    (claude) in a PTY, renders it with pyte, and forwards keystrokes — so the
    full TUI works: mode switching, slash commands, per-step yes/no prompts.

    Ctrl+B detaches back to the deck without killing the program."""

    class Detached(Message):
        pass

    KEY_MAP = {
        "enter": b"\r", "tab": b"\t", "backspace": b"\x7f", "escape": b"\x1b",
        "up": b"\x1b[A", "down": b"\x1b[B", "right": b"\x1b[C", "left": b"\x1b[D",
        "home": b"\x1b[H", "end": b"\x1b[F", "pageup": b"\x1b[5~",
        "pagedown": b"\x1b[6~", "delete": b"\x1b[3~", "shift+tab": b"\x1b[Z",
        "space": b" ",
    }

    def __init__(self, argv, env=None, cwd=None, **kw):
        super().__init__(**kw)
        self.argv = argv
        self.env = env
        self.cwd = cwd if (cwd and os.path.isdir(cwd)) else None
        self.cols, self.rows = 80, 24
        self.pid = None
        self.master_fd = None
        self.alive = False
        self._screen = pyte.HistoryScreen(self.cols, self.rows, history=2000)
        self._stream = pyte.ByteStream(self._screen)
        self._queue = queue.Queue()

    def on_mount(self):
        w = max(20, self.size.width or 80)
        h = max(6, self.size.height or 24)
        self.cols, self.rows = w, h
        self._screen.resize(h, w)
        self._spawn()
        self.set_interval(1 / 20, self._drain)
        self.focus()

    def _spawn(self):
        try:
            pid, fd = pty.fork()
        except Exception:
            return
        if pid == 0:                       # child -> becomes the program
            try:
                if self.cwd:
                    os.chdir(self.cwd)
                os.environ["TERM"] = "xterm-256color"
                os.execvpe(self.argv[0], self.argv, self.env or os.environ)
            except Exception:
                os._exit(1)
        self.pid = pid
        self.master_fd = fd
        self.alive = True
        self._set_winsize(self.rows, self.cols)
        threading.Thread(target=self._reader, daemon=True).start()

    def _set_winsize(self, rows, cols):
        if self.master_fd is not None:
            try:
                fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ,
                            struct.pack("HHHH", rows, cols, 0, 0))
            except Exception:
                pass

    def _reader(self):
        while self.alive:
            try:
                data = os.read(self.master_fd, 8192)
            except OSError:
                break
            if not data:
                break
            self._queue.put(data)
        self.alive = False
        self._queue.put(None)

    def _drain(self):
        changed = False
        while True:
            try:
                data = self._queue.get_nowait()
            except queue.Empty:
                break
            if data is None:
                self.alive = False
                continue
            try:
                self._stream.feed(data)
            except Exception:
                pass
            changed = True
        if changed:
            self.refresh()

    def on_resize(self, event):
        w = max(20, self.size.width)
        h = max(6, self.size.height)
        if (w, h) != (self.cols, self.rows):
            self.cols, self.rows = w, h
            try:
                self._screen.resize(h, w)
            except Exception:
                pass
            self._set_winsize(h, w)
            self.refresh()

    def render(self):
        scr = self._screen
        cy, cx = scr.cursor.y, scr.cursor.x
        text = Text()
        for y in range(scr.lines):
            row = scr.buffer[y]
            for x in range(scr.columns):
                ch = row[x]
                data = ch.data if (ch.data and ch.data != "\x00") else " "
                fg = _pyte_color(ch.fg)
                bg = _pyte_color(ch.bg)
                if ch.reverse:
                    fg, bg = bg, fg
                if y == cy and x == cx:      # draw the cursor as an inverse block
                    fg, bg = (bg or "#1e1e2e"), (fg or "#cdd6f4")
                text.append(data, Style(color=fg, bgcolor=bg, bold=ch.bold,
                                        italic=ch.italics, underline=ch.underscore))
            if y < scr.lines - 1:
                text.append("\n")
        return text

    def _key_to_bytes(self, event):
        k = event.key
        if k == "ctrl+b":                  # reserved: detach back to the deck
            return None
        if k in self.KEY_MAP:
            return self.KEY_MAP[k]
        if k.startswith("ctrl+") and len(k) == 6 and "a" <= k[5] <= "z":
            return bytes([ord(k[5]) - 96])
        ch = event.character
        if ch and ch.isprintable():
            return ch.encode("utf-8")
        return None

    def on_key(self, event):
        if event.key == "ctrl+b":
            event.stop(); event.prevent_default()
            self.post_message(self.Detached())
            return
        if not self.alive or self.master_fd is None:
            return
        data = self._key_to_bytes(event)
        if data is not None:
            event.stop(); event.prevent_default()
            try:
                os.write(self.master_fd, data)
            except OSError:
                pass

    def shutdown(self):
        self.alive = False
        if self.pid:
            try:
                os.kill(self.pid, signal.SIGKILL)
            except Exception:
                pass
            self.pid = None
        if self.master_fd is not None:
            try:
                os.close(self.master_fd)
            except Exception:
                pass
            self.master_fd = None

    def on_unmount(self):
        self.shutdown()


class TaskRow(ListItem):
    """A row in the conversations list. Either a real chat (carries tty + session
    id) or a non-selectable section header (is_header=True)."""

    def __init__(self, *, tty, live, markup, row_key, is_header=False):
        super().__init__(Label(Text.from_markup(markup)))
        self.tty = tty
        self.live = live
        self.row_key = row_key
        self.is_header = is_header
        if is_header:
            self.disabled = True   # headers can't be highlighted or clicked


